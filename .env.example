# Model specs are "<provider>:<model id>". Providers: anthropic, google, openai.
EXTRACTION_MODEL=anthropic:claude-haiku-5-5
ESCALATION_MODEL=anthropic:claude-sonnet-5-5

ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

# Resilience: another provider answers when the primary times out or is down (eval it first: npm run evals -- --model=<it>).
# FALLBACK_MODEL=openai:<model id>
# MODEL_TIMEOUT_MS=60000
# MODEL_RETRIES=1

# Contracts service (services/contracts). Unset = contract price check off.
# CONTRACTS_URL=http://localhost:8001
# CONTRACTS_TIMEOUT_MS=15000
# CONTRACT_SELECT_MODEL=anthropic:claude-haiku-5-5   # read by the Python service

# Optional pricing override, USD per 1M tokens, merged over the built-in table:
# MODEL_PRICING_JSON={"google:gemini-x":{"input":0.1,"output":0.4}}

# Langfuse (phase 3)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL (not the legacy LANGFUSE_BASEURL): the Mastra exporter only reads this name.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
# PROMPT_SOURCE=local   # pin the local prompt even when Langfuse is configured
